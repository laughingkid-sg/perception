{
  "name": "perception-apps",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "housing-affordability-calculator",
    "us-compensation-compare"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:housing": "npm run dev --workspace=sg-property-options",
    "dev:compensation": "npm run dev --workspace=us-compensation-compare",
    "build": "npm run build --workspaces --if-present",
    "build:housing": "npm run build --workspace=sg-property-options",
    "build:compensation": "npm run build --workspace=us-compensation-compare",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  }
}
