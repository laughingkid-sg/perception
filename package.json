{
  "name": "perception-apps",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "housing-affordability-calculator",
    "trading-course",
    "us-compensation-compare"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:housing": "npm run dev --workspace=sg-property-options",
    "dev:trading": "npm run dev --workspace=trading-course",
    "dev:compensation": "npm run dev --workspace=us-compensation-compare",
    "build": "npm run build:apps && npm run assemble",
    "build:apps": "npm run build --workspaces --if-present",
    "build:housing": "npm run build --workspace=sg-property-options",
    "build:trading": "npm run build --workspace=trading-course",
    "build:compensation": "npm run build --workspace=us-compensation-compare",
    "assemble": "node scripts/assemble-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "preview": "vite preview --outDir dist --host 127.0.0.1 --port 4173 --strictPort",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  }
}
